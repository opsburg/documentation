{
  // Not used to compile (Docusaurus transpiles on its own): editor support and
  // `pnpm typecheck`. It is @docusaurus/tsconfig inlined without `baseUrl`,
  // which TypeScript 7 removed and the Docusaurus preset still sets.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "types": ["@docusaurus/module-type-aliases"],
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build", "node_modules"]
}
